{
  "plugin_id": "SubscribeAutoKeep",
  "render_mode": "vuetify",
  "description": "配置页 Vuetify JSON 快照。运行时由 __init__.py 的 get_form() 生成同一份结构，并把 sites 的 items 动态替换为 SiteOper.list_active() 的站点列表；本文件供审阅与二次开发使用。",
  "form": [
    {
      "component": "VForm",
      "content": [
        {
          "component": "VRow",
          "content": [
            {
              "component": "VCol",
              "props": { "cols": 12 },
              "content": [
                {
                  "component": "VAlert",
                  "props": { "type": "warning", "variant": "tonal", "density": "compact" },
                  "text": "命中后本插件会删除订阅、种子及种子文件、转移记录、媒体库文件，不可回滚。请务必先用【测试模式】跑一轮，核对日志里的证据链，再关闭测试模式。"
                }
              ]
            }
          ]
        },
        {
          "component": "VRow",
          "content": [
            { "component": "VCol", "props": { "cols": 12, "md": 6 }, "content": [{ "component": "VSwitch", "props": { "model": "enabled", "label": "启用插件" } }] },
            { "component": "VCol", "props": { "cols": 12, "md": 6 }, "content": [{ "component": "VSwitch", "props": { "model": "test_mode", "label": "测试模式（只记日志，不删除）" } }] }
          ]
        },
        {
          "component": "VRow",
          "content": [
            { "component": "VCol", "props": { "cols": 12, "md": 6 }, "content": [{ "component": "VTextField", "props": { "model": "cron", "label": "Cron 定时表达式", "placeholder": "0 4 * * *", "hint": "5 段：分 时 日 月 周，例如每天 04:00 为 0 4 * * *", "persistent-hint": true } }] },
            {
              "component": "VCol",
              "props": { "cols": 12, "md": 6 },
              "content": [
                {
                  "component": "VSelect",
                  "props": {
                    "model": "resolution",
                    "label": "分辨率",
                    "item-title": "title",
                    "item-value": "value",
                    "items": [
                      { "title": "全部", "value": "any" },
                      { "title": "4k", "value": "4k" },
                      { "title": "1080p", "value": "1080p" },
                      { "title": "720p", "value": "720p" }
                    ],
                    "hint": "选一档可保证新旧资源规格一致；「全部」= 不限制",
                    "persistent-hint": true
                  }
                }
              ]
            }
          ]
        },
        {
          "component": "VRow",
          "content": [
            {
              "component": "VCol",
              "props": { "cols": 12 },
              "content": [
                {
                  "component": "VSelect",
                  "props": {
                    "model": "sites",
                    "label": "监控站点（多选，留空 = 全部站点）",
                    "items": [],
                    "item-title": "title",
                    "item-value": "value",
                    "multiple": true,
                    "chips": true,
                    "closable-chips": true,
                    "hint": "运行时动态注入 [{title: 站点名, value: 站点ID}]；只检索勾选站点的整季全集",
                    "persistent-hint": true
                  }
                }
              ]
            }
          ]
        },
        {
          "component": "VRow",
          "content": [
            {
              "component": "VCol",
              "props": { "cols": 12 },
              "content": [
                { "component": "VBtn", "props": { "color": "primary", "variant": "flat", "size": "small", "class": "mr-2 mb-2" }, "text": "立即扫描一次", "events": { "click": { "api": "plugin/SubscribeAutoKeep/run", "method": "post", "params": {} } } }
              ]
            }
          ]
        },
        {
          "component": "VRow",
          "content": [
            {
              "component": "VCol",
              "props": { "cols": 12 },
              "content": [
                {
                  "component": "VAlert",
                  "props": { "type": "info", "variant": "tonal", "density": "compact" },
                  "text": "固定流程：命中同季整季全集 → 等待 15 分钟并持续复检种子是否还在（消失则取消） → 删除订阅/种子及种子文件/转移记录/媒体库文件 → 10 分钟后自动下载整季全集。先删旧再下新，MP 才会重新转移刮削。"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "defaults": {
    "enabled": false,
    "test_mode": true,
    "cron": "0 4 * * *",
    "sites": [],
    "resolution": "any"
  }
}
